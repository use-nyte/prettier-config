{
  "name": "@use-nyte/prettier-config",
  "version": "2.0.4",
  "description": "Shared Prettier config for use-nyte projects.",
  "repository": "https://github.com/use-nyte/prettier-config",
  "license": "Apache-2.0",
  "main": "./src/prettier.config.mjs",
  "bin": {
    "format": "src/cli.mjs"
  },
  "scripts": {
    "build": "pnpm pack --dry-run --ignore-scripts",
    "test": "node --test",
    "lint": "pnpm exec lint",
    "format": "node src/cli.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "ignore": "7.0.17",
    "prettier": "3.10.1",
    "prettier-plugin-organize-class-members": "1.0.0-beta.6",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-tailwindcss": "0.8.1"
  },
  "devDependencies": {
    "@use-nyte/eslint-config": "2.1.0",
    "husky": "9.1.7"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": "26.13.1"
  },
  "packageManager": "pnpm@12.23.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  }
}
