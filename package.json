{
  "name": "@use-nyte/prettier-config",
  "version": "2.0.0",
  "description": "Shared Prettier config for use-nyte projects.",
  "repository": "https://github.com/use-nyte/prettier-config",
  "license": "Apache-2.0",
  "main": "./src/prettier.config.mjs",
  "bin": {
    "format": "src/cli.mjs"
  },
  "scripts": {
    "format": "node src/cli.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "ignore": "^5.3.2",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-class-members": "1.0.0-beta.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.0"
  },
  "devDependencies": {
    "@use-nyte/eslint-config": "^1.4.0",
    "husky": "^9.1.7"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "files": [
    "src"
  ],
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  }
}
